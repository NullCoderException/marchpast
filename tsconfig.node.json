{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vite",
    "src/schema",
    // The mark's drawing: `vite/public.test.ts` holds `public/404.html`'s copy
    // of it to this original, and the module is bare strings with no imports.
    "src/app/mark.ts",
    "src/data/library.ts",
    "src/render/layout.ts",
    "src/render/text.ts",
    "src/timeline"
  ],
  "exclude": ["src/schema/*.test.ts", "src/timeline/*.test.ts"]
}
